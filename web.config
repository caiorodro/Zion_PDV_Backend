<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform 
      stdoutLogEnabled="true" 
      stdoutLogFile=".\logs\python.log"
      startupTimeLimit="20"
      processPath="C:\Users\zionp\AppData\Local\Programs\Python\Python310\python.exe"
      arguments="-m uvicorn main:app --host 0.0.0.0 --port 1199 %HTTP_PLATFORM_PORT%" />
  </system.webServer>
</configuration>